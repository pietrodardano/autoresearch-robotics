# GOAL.md Template & Track Configuration Reference
#
# This file provides examples for each of the 6 research tracks supported by the harness:
# 1. reservoir: Echo state networks / reservoir computing (frozen reservoir, closed-form readout)
# 2. dl_supervised: Deep neural network learning (gradient-based optimization)
# 3. world_model: Latent dynamics, prediction, and model-based rollout planning
# 4. probabilistic: Bayesian learning, variational inference, Monte Carlo, and ensembles
# 5. spiking: Neuromorphic & spiking networks (surrogate gradients OR local STDP rules)
# 6. rl_policy: Reinforcement learning policy/value network optimization
#
# Copy one of the sections below to GOAL.md to activate that track.
# The agent may NOT modify GOAL.md. Only the human operator selects track & caps.

---
# ==============================================================================
# EXAMPLE 1: RESERVOIR COMPUTING TRACK
# ==============================================================================
goal: "Predict chaotic Mackey-Glass time series dynamics with minimum error and minimal parameter complexity."
track: reservoir
task: toy_mackey_glass
learning_rule: closed_form             # Allowed: closed_form, ridge, convex
seeds: [42, 43, 44]
metric: nmse                           # Normalized Mean Squared Error
metric_direction: min                  # 'min' (lower is better) or 'max'
min_gain: 0.01                         # Minimum 1% improvement required over best
noise_floor: 0.0001                    # Floor to reject noise fluctuations
hard_timeout: 120                      # Hard timeout in seconds for evaluate.py
frozen:
  - reservoir_weights
  - input_weights
  - bias
constraints:
  max_params: 500000                   # Max total parameters
  max_state_dim: 2000                  # Max reservoir internal state dimension
  max_readout_features: 2000           # Max features projected to readout
  max_flops_or_sops: 10000000.0        # Max FLOPs/SOPs per inference step
  max_memory_mb: 4096.0                # Max peak memory in MB
  max_wall_time_s: 60.0                # Max wall-clock time per seed in seconds

